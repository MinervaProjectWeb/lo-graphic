<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script>
    // A method that helps regulate which LOs are shown at a given time.
    // When the page is initially loaded, all the LOs should be hidden except for criticalthinking_los.
    // At most one set of LOs should be shown at a time.
    // When a CO/core competency is clicked,
    // - if the LOs for that CO/core competency are hidden, show them
    // - if the LOs for that CO/core competency are shown, hide them
    // - if the LOs for another CO/core competency are shown, hide them and show the LOs for the clicked CO/core competency
    const showAppropriateLos = () => {
        const button_ids = ["disciplinary_btn", "effectiveinteraction_btn", "effectivecommunication_btn", "creativethinking_btn", "criticalthinking_btn"];
        const los_ids = ["disciplinary_los", "effectiveinteraction_los", "effectivecommunication_los", "creativethinking_los", "criticalthinking_los"];
        
        // Initially hide all los_ids except for criticalthinking_los
        los_ids.forEach((los_id) => {
            if (los_id !== "criticalthinking_los") {
                $(`#${los_id}`).hide();
            } else {
                $(`#${los_id}`).show(); // Ensure criticalthinking_los is visible
            }
        });
        
        button_ids.forEach((button_id, index) => {
            $(`#${button_id}`).click(() => {
                $(`#${los_ids[index]}`).toggle();
                los_ids.forEach((los_id, i) => {
                    if (i !== index) {
                        $(`#${los_id}`).hide();
                    }
                });
            });
        });
    }
    $(document).ready(() => {
        showAppropriateLos();
    });
</script>
